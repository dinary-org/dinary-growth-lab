 "captions": [
  {
   "start": 0.08,
   "end": 3.021,
   "text": "매일 밤 열한 시. 삼각김밥"
  },
  {
   "start": 3.021,
   "end": 3.805,
   "text": "두 개."
  },
  {
   "start": 4.58,
   "end": 6.961,
   "text": "할아버지는 늘 같은 것만"
  },
  {
   "start": 6.961,
   "end": 7.511,
   "text": "샀다."
  },
  {
   "start": 9.08,
   "end": 11.342,
   "text": "할인 스티커 붙은 것만"
  },
  {
   "start": 11.342,
   "end": 12.095,
   "text": "골라서."
  },
  {
   "start": 13.58,
   "end": 16.062,
   "text": "봉투도 필요 없다고 했다."
  },
  {
   "start": 18.08,
   "end": 20.27,
   "text": "솔직히 좀 짠돌이인 줄"
  },
  {
   "start": 20.27,
   "end": 21.0,
   "text": "알았다."
  },
  {
   "start": 22.58,
   "end": 24.922,
   "text": "그러다 석 달째 되던 날."
  },
  {
   "start": 27.08,
   "end": 29.505,
   "text": "하나를 계산대에 두고 갔다."
  },
  {
   "start": 31.58,
   "end": 34.212,
   "text": "야간 알바 학생, 밥은 먹고"
  },
  {
   "start": 34.212,
   "end": 34.738,
   "text": "해요."
  },
  {
   "start": 37.08,
   "end": 39.708,
   "text": "두 개 중 하나는 처음부터 내"
  },
  {
   "start": 39.708,
   "end": 40.365,
   "text": "거였다."
  },
  {
   "start": 42.08,
   "end": 44.306,
   "text": "이 이야기는 창작입니다."
  }
 ],
