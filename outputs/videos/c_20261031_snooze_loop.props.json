   "text": "잔다."
  },
  {
   "start": 20.48,
   "end": 22.764,
   "text": "그날 밤 열한 시 오십팔 분."
  },
  {
   "start": 22.68,
   "end": 23.585,
   "text": "일곱 시."
  }
 ],
