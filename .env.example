# DINARY Growth Lab — copy to .env (never commit .env).
# In Claude Code Cloud, set these as environment variables / network secrets
# in the cloud environment settings instead of a file.

# --- Discovery -------------------------------------------------------------
# YouTube Data API v3 key (Google Cloud console > APIs & Services > Credentials).
# Needs the "YouTube Data API v3" enabled. Default quota: 10,000 units/day.
YOUTUBE_API_KEY=
# Daily quota budget the engine may spend (search.list = 100 units, videos/channels.list = 1).
YOUTUBE_DAILY_QUOTA=8000
# Primary market for chart sampling and Korean-language exploration.
DGL_REGION=KR
DGL_LANGUAGE=ko

# Apify API token (console.apify.com > Settings > Integrations). Used for
# public Instagram Reels metadata via Apify Store actors.
APIFY_TOKEN=
# Hard cap on Apify spend per run, USD.
APIFY_MAX_USD_PER_RUN=2.00
APIFY_REEL_ACTOR=apify~instagram-reel-scraper
APIFY_HASHTAG_ACTOR=apify~instagram-hashtag-scraper

# --- Persistence -----------------------------------------------------------
# Supabase project for research data. Use a DEDICATED project or the `growth_lab`
# schema; the service-role key must stay server-side only.
SUPABASE_URL=
# New-style projects: put the sb_secret_... key in SUPABASE_SECRET_KEY instead (either name works).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=growth_lab

# Cloudflare R2 (S3-compatible) for rendered videos / authorized media.
# Either the account id or the full S3 endpoint https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME is accepted as an alias
R2_BUCKET=dinary-growth-lab

# --- Generation (optional) -------------------------------------------------
# Claude API for automated concept writing outside an interactive session.
ANTHROPIC_API_KEY=
DGL_CLAUDE_MODEL=claude-opus-5-5
# Runway API for optional generative B-roll.
RUNWAYML_API_SECRET=
# Optional cloud transcription (used when local Whisper models are unavailable).
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Own-channel performance feedback (Phase 6) ----------------------------
# YouTube Analytics needs OAuth for the channel owner (refresh token flow).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Instagram Graph API (professional account) for Reels insights.
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Runtime ---------------------------------------------------------------
DGL_DATA_DIR=data
DGL_WORK_DIR=work
# Browser for Remotion rendering (cloud image ships one here).
REMOTION_BROWSER_EXECUTABLE=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell
